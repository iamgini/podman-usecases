# Based on upstream: https://github.com/webpro/reveal-md
# reveal-md requires Node ^18.18.0 || ^20.9.0 || ^22.0.0 — pinned to 22-alpine
# Includes Python preflight script for slide overflow detection

FROM node:22-alpine

ARG REVEAL_MD_VERSION=6.1.4

# Skip Chromium download (slide serving only; not needed for HTTP mode)
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Install reveal-md and Python
RUN npm install -g reveal-md@${REVEAL_MD_VERSION} && \
    rm -rf /root/.npm && \
    apk add --no-cache python3

# Copy scripts
COPY preflight.py  /usr/local/bin/preflight.py
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Non-root user
RUN addgroup -S revealmd && adduser -S revealmd -G revealmd

USER revealmd

WORKDIR /slides

EXPOSE 1948

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/slides/slides.md", "--host", "0.0.0.0"]
